# 同じバイトコードを幅1・幅64・本体C++ホストへ渡し、各経路の全要素検査を照合する。
foreach(route IN ITEMS reference batch host)
    if(route STREQUAL host)
        set(command "${HOST}" "${MODULE}")
    elseif(route STREQUAL reference)
        set(command "${RUNNER}" "${MODULE}" --reference --report)
    else()
        set(command "${RUNNER}" "${MODULE}" --report)
    endif()
    execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT status EQUAL 0 OR NOT output MATCHES "^main returned 0")
        message(FATAL_ERROR "${route} failed (${status}): ${output}\n${error}")
    endif()
    message(STATUS "${route}: ${output}${error}")
endforeach()
